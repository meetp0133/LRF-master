<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aservey - Welcome</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
    <style type="text/css">
        * {
            border: none;
            outline: none;
        }

        :root {
            color-scheme: light dark;
        }

        body {
            padding: 0;
            margin: 0;
        }

        tr,
        td,
        th,
        thead,
        tbody,
        table {
            border-spacing: 0;
        }

        td{
            font-size: 16px;
            font-family: 'Forum', serif;
            line-height: 1.3;
        }


        @media (prefers-color-scheme: dark) {
            td {
                color: #ffffff !important;
            }

        }
    </style>
</head>

<body style="background: #fff;margin: 0;padding: 0;font-family: 'Forum', serif;">
<table align="center" width="500px" border="0" cellspacing="0" cellpadding="0"
       style="border: 1px solid #faeff6;">
    <!-- Banner -->
    <tr>
        <td valign="top" align="center">
            <table align="center" border="0" width="100%" cellspacing="0" cellpadding="0"
                   style="table-layout:fixed;">
                <tr>
                    <td valign="center" align="start" style="padding: 30px 0px;text-align: center;background: #ECEBFD;">
                        <img src="<%=locals.baseUrl%>images/aservey-logo.png" alt="banner-image">
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- End Banner -->

    <!-- Body -->
    <tr>
        <td valign="top" align="center"
            style="padding: 40px 20px;">
            <table align="center" border="0" width="100%" cellspacing="0" cellpadding="0"
                   style="table-layout:fixed;margin: 0; padding: 0;">
                <tr>
                    <td valign="center" align="center" width="100%"
                        style="font-family: 'Forum', serif;font-size: 18px;line-height: 1.2; padding-bottom: 20px;">
                        Dear <%=locals.userName%>,
                    </td>
                </tr>
                <tr>
                    <td valign="center" align="center" width="100%" style="font-size: 14px; line-height: 1.2; font-weight: 500;font-family: 'Forum', serif;">
                        Welcome to Aservey.
                    </td>
                </tr>
                <tr>
                    <td valign="center" align="center" width="100%"
                        style="font-size: 14px; line-height: 1.2; font-family: 'Forum', serif; text-align: center; padding-bottom: 20px;">
                        We are thrilled to have you as a part of our learning community.
                        Our mission is to provide high-quality educational resources and a supportive learning environment to help you achieve your academic goals.
                    </td>
                </tr>
                <tr>
                    <td valign="center" align="center" width="100%" style="font-size: 14px; line-height: 1.2; font-family: 'Forum', serif; text-align: center; padding-bottom: 20px;">
                        Thank you for choosing Aservey as your learning partner. We are excited to support you on your educational journey.
                    </td>
                </tr>
                <tr>
                    <td valign="center" align="center" width="100%" style="font-size: 14px;line-height: 1.2;">
                        Best Regards,<br>
                        Your Aservey Team
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- End Body -->

</table>
</body>

</html>